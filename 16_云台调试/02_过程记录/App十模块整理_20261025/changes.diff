-    manager->reason = SAFETY_POWER_ON;
-}
-
-void SafetyManager_Step(SafetyManager *manager, const SafetyInput *input,
-                        const RemoteCommand *command)
-{
-    SafetyReason fault = SAFETY_NONE;
-    uint8_t new_frame;
