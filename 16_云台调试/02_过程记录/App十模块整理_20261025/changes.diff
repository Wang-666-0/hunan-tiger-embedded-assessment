-uint8_t PitchConsole_Poll(char *response, size_t capacity)
-{
-    PitchBackendState pitch;
-    PitchStep snapshot, report;
-    PitchRemoteStepEvent event;
-    uint8_t operation;
-    uint32_t started, first_rx, last_query;
