+{
+    uint8_t ready = 0U;
+    if (!out) { return 0U; }
+    taskENTER_CRITICAL();
+    if (previous_step.pending) { *out = previous_step; previous_step.pending = 0U; ready = 1U; }
+    else if (step.pending) { *out = step; step.pending = 0U; ready = 1U; }
