-void TargetManager_Step(TargetManager *manager, const RemoteCommand *command,
-    uint8_t new_frame, uint8_t operator_armed, uint8_t flywheels_ready, uint32_t now_ms)
-{
-#if APP_REMOTE_PROFILE_ASSESSMENT
