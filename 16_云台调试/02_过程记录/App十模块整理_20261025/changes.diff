-uint8_t DmDiag_IsReadableRid(uint8_t rid)
-{
-    uint32_t i;
-    for (i = 0U; i < DmDiag_ReadableRidCount; ++i) {
-        if (DmDiag_ReadableRids[i] == rid) { return 1U; }
