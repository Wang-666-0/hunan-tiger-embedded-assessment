-    if (frame->id == 0x7FFU) { return 0U; }
-    return (uint8_t)(frame->data[0] == (uint8_t)(APP_PITCH_DEVICE_ID & 0xFFU)
-        && frame->data[1] == (uint8_t)((APP_PITCH_DEVICE_ID >> 8) & 0xFFU)
-        && frame->data[2] == 0x33U && frame->data[3] == rid);
-}
