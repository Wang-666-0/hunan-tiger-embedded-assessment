+uint8_t PitchBackend_CanHoldForYawStep(void)
+{
+    uint8_t ready;
+    taskENTER_CRITICAL();
+    ready = (uint8_t)(state.coord_confirmed && state.zero_set && state.controller.have_reference &&
+        state.requested && state.active && state.controller.active && !state.enabling && !state.stop_pending &&
+        Online(HAL_GetTick()) && state.feedback.status == 1U && !state.controller.faults &&
+        CanBus_PitchAllowed() && step.phase != PITCH_STEP_RUNNING &&
+        (state.controller.gravity_kg_nm == 0.0f || state.controller.gravity_calibrated) &&
+        state.controller.angle_deg >= PITCH_CONTROLLER_TARGET_MIN_DEG &&
+        state.controller.angle_deg <= PITCH_CONTROLLER_TARGET_MAX_DEG &&
+        (state.yaw_step_hold || (fabsf(state.controller.velocity_dps) <= PITCH_CONTROLLER_STATIONARY_SPEED_DPS &&
+            state.controller.stationary_samples >= 2U &&
+            state.controller.last_feedback_ms - state.controller.stationary_started_ms >= PITCH_CONTROLLER_STATIONARY_HOLD_MS)));
+    taskEXIT_CRITICAL(); return ready;
+}
+uint8_t PitchBackend_HoldForYawStep(uint8_t hold)
+{
+    uint8_t accepted = 0U;
+    taskENTER_CRITICAL();
+    if (!hold) { state.yaw_step_hold = 0U; accepted = 1U; }
+    else if (PitchBackend_CanHoldForYawStep()) {
+        if (state.yaw_step_hold) { accepted = 1U; }
+        else if (PitchController_SetTarget(&state.controller, state.controller.angle_deg)) {
+            state.yaw_step_hold = 1U; state.step_hold = 0U; accepted = 1U;
+        }
+    }
+    taskEXIT_CRITICAL(); return accepted;
+}
