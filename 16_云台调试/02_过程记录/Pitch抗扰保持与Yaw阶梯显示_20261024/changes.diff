+    pitch->cascade.speed.kp *= APP_PITCH_VIEW_HOLD_SPEED_GAIN;
+    pitch->cascade.speed.kd *= APP_PITCH_VIEW_HOLD_SPEED_GAIN;
+    torque = PitchController_Update(pitch, 0.0f, now_ms, allowed);
+    pitch->cascade.position = position; pitch->cascade.speed = speed;
+    return torque;
+}
