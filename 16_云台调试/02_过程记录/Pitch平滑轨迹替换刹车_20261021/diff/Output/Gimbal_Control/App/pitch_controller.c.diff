+        !finite_value(velocity_gain) || velocity_gain < 0.0f || velocity_gain > 1.0f) { return 0U; }
+    if (pitch->shape.duration_ms == duration_ms && pitch->shape.velocity_gain == velocity_gain) { return 1U; }
