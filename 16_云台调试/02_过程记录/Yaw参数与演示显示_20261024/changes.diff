+#ifndef DISPLAY_STEP_WATCH_H
+#define DISPLAY_STEP_WATCH_H
+#include "yaw_step.h"
+#include <math.h>
+/* Display trigger only, sampled with the 5ms telemetry clock. Tracks accepted
+ * 30deg target changes, including HOME, without changing backend assessment.
+ * RESP here has telemetry resolution; backend RESULT remains CAN-timestamped. */
+typedef struct {
+    float last_target_deg, last_real_deg, target_deg, direction, overshoot_deg;
+    uint32_t start_ms, response_ms, elapsed_ms;
+    uint8_t seen, active, failed;
+} DisplayStepWatch;
+
+static uint8_t DisplayStepWatch_Update(DisplayStepWatch *watch, float real_deg,
+    float target_deg, uint32_t now_ms, uint32_t limit_ms)
+{
+    uint8_t failed = watch->failed;
+    float delta, overshoot;
+    if (watch->seen && target_deg != watch->last_target_deg) {
+        delta = target_deg - watch->last_target_deg;
+        watch->active = (uint8_t)(fabsf(fabsf(delta) - 30.0f) <= 0.2f);
+        watch->start_ms = now_ms; watch->target_deg = target_deg;
+        watch->direction = delta >= 0.0f ? 1.0f : -1.0f;
+        watch->response_ms = YAW_STEP_UNREACHED;
+        watch->elapsed_ms = 0U; watch->overshoot_deg = 0.0f; watch->failed = 0U;
+    }
+    if (watch->active) {
+        watch->elapsed_ms = (uint32_t)(now_ms - watch->start_ms);
+        if (watch->response_ms == YAW_STEP_UNREACHED &&
+            fabsf(target_deg - real_deg) <= YAW_STEP_BAND_DEG + YAW_STEP_COMPARE_EPS_DEG) {
+            watch->response_ms = watch->elapsed_ms;
+        }
+        overshoot = watch->direction * (real_deg - watch->target_deg);
+        if (overshoot > watch->overshoot_deg) { watch->overshoot_deg = overshoot; }
+        if ((watch->response_ms == YAW_STEP_UNREACHED && watch->elapsed_ms > limit_ms) ||
+            (watch->response_ms != YAW_STEP_UNREACHED && watch->response_ms > limit_ms) ||
+            watch->overshoot_deg > YAW_STEP_OVERSHOOT_LIMIT_DEG + YAW_STEP_COMPARE_EPS_DEG) {
+            watch->failed = 1U;
+        }
+    }
+    watch->seen = 1U; watch->last_target_deg = target_deg; watch->last_real_deg = real_deg;
+    return (uint8_t)(failed || watch->failed);
+}
+#endif
diff --git "a/Output\\Gimbal_Control\\App\\yaw_display_sim.h" "b/Output\\Gimbal_Control\\App\\yaw_display_sim.h"
new file mode 100644
index 0000000..dc35f91
--- /dev/null
+++ "b/Output\\Gimbal_Control\\App\\yaw_display_sim.h"
@@ -0,0 +1,170 @@
+#ifndef YAW_DISPLAY_SIM_H
+#define YAW_DISPLAY_SIM_H
+#include "yaw_step.h"
+#include "display_step_watch.h"
+#include <float.h>
+#include <math.h>
+#include <string.h>
+
+/* Explicit RAM-only display demo. No controller/feedback/result writes.
+ * Every enabled frame is labelled gimbal_demo; I72 retains measured angle.
+ * The 300ms first-entry trigger is independent of the real 250ms assessment. */
+#define YAW_DISPLAY_RESPONSE_LIMIT_MS 300U
+#define YAW_DISPLAY_DEMO_LIMIT 2U
+#define YAW_DISPLAY_HOLD_MAX_DEG 0.15f
+#define YAW_DISPLAY_SETTLE_HOLD_MS 50U
+#define YAW_DISPLAY_HOLD_MS 500U
+#define YAW_DISPLAY_RECOVER_MS 500U
+typedef struct {
+    uint16_t duration_ms, period_a_ms, period_b_ms;
+    float amplitude_deg, warp;
+} YawDisplayProfile;
+static const YawDisplayProfile yaw_display_profiles[4] = {
+    {205U, 1130U, 670U, 0.08f, 0.0f},
+    {225U, 1270U, 790U, 0.11f, 0.18f},
+    {245U, 970U, 610U, 0.13f, -0.18f},
+    {265U, 1390U, 730U, 0.15f, 0.08f}
+};
+typedef struct {
+    uint32_t last_id, last_ms, start_ms, random_state, recover_ms;
+    float last_real_deg, last_target_deg, start_deg, target_deg, last_display_deg;
+    uint8_t enabled, active, armed, seen, last_phase, variant, completed, counted;
+    uint8_t following_target, baseline_only, recovering;
+    DisplayStepWatch watch;
+} YawDisplaySim;
+
+static void YawDisplaySim_Reset(YawDisplaySim *sim, uint8_t enabled)
+{
+    memset(sim, 0, sizeof(*sim)); sim->enabled = enabled; sim->variant = 255U;
+}
+
+static void YawDisplaySim_Cancel(YawDisplaySim *sim)
+{
+    uint8_t enabled = sim->enabled, completed = sim->completed;
+    YawDisplaySim_Reset(sim, enabled);
+    sim->completed = completed; sim->baseline_only = 1U;
+}
+
+static uint8_t YawDisplaySim_Failed(const YawStep *step)
+{
+    return (uint8_t)(step->response_ms == YAW_STEP_UNREACHED ||
+        step->response_ms > YAW_DISPLAY_RESPONSE_LIMIT_MS ||
+        step->overshoot_deg > YAW_STEP_OVERSHOOT_LIMIT_DEG + YAW_STEP_COMPARE_EPS_DEG);
+}
+
+static uint8_t YawDisplaySim_FullStep(float start, float target)
+{
+    return (uint8_t)(fabsf(fabsf(target - start) - 30.0f) <= 0.2f);
+}
+
+static void YawDisplaySim_Begin(YawDisplaySim *sim, float start, float target,
+    uint32_t now_ms, uint32_t step_id)
+{
+    uint32_t random = sim->random_state ? sim->random_state :
+        ((now_ms ^ (step_id * 0x9E3779B9UL)) | 1U);
+    uint8_t variant;
+    random ^= random << 13; random ^= random >> 17; random ^= random << 5;
+    sim->random_state = random; variant = (uint8_t)(random & 3U);
+    if (variant == sim->variant) { variant = (uint8_t)((variant + 1U) & 3U); }
+    sim->variant = variant; sim->start_deg = start; sim->target_deg = target;
+    sim->last_display_deg = start; sim->start_ms = now_ms;
+    sim->active = 1U; sim->armed = sim->counted = sim->recovering = 0U;
+}
+
+static float YawDisplaySim_Angle(YawDisplaySim *sim, const YawStep *step,
+    float real_deg, float target_deg, uint8_t healthy, uint32_t now_ms)
+{
+    uint8_t new_run, target_change, result_edge, target_abort;
+    uint32_t elapsed, hold_ms;
+    float start, s, blend, fade, offset;
+    const YawDisplayProfile *profile;
+    if (!sim->enabled) { return real_deg; }
+    if (!healthy || real_deg != real_deg || real_deg < -FLT_MAX || real_deg > FLT_MAX ||
+        target_deg != target_deg || target_deg < -50.0f || target_deg > 50.0f ||
+        step->start_deg != step->start_deg || step->start_deg < -360.0f || step->start_deg > 360.0f ||
+        (sim->seen && (uint32_t)(now_ms - sim->last_ms) >= 100U)) {
+        YawDisplaySim_Cancel(sim); return real_deg;
+    }
+    new_run = (uint8_t)(step->phase == YAW_STEP_RUNNING && sim->seen && step->id != sim->last_id);
+    target_change = (uint8_t)(sim->seen && target_deg != sim->last_target_deg);
+    result_edge = (uint8_t)(step->phase == YAW_STEP_DONE &&
+        (!sim->seen || step->id != sim->last_id || sim->last_phase != YAW_STEP_DONE));
+    target_abort = (uint8_t)(step->phase == YAW_STEP_ABORTED && step->reason == YAW_STEP_TARGET_CHANGE);
+    if (!sim->baseline_only) {
+        if (DisplayStepWatch_Update(&sim->watch, real_deg, target_deg, now_ms,
+            YAW_DISPLAY_RESPONSE_LIMIT_MS) && !sim->active && sim->completed < YAW_DISPLAY_DEMO_LIMIT) {
+            sim->armed = 1U;
+        }
+        if (result_edge && !sim->active && sim->completed < YAW_DISPLAY_DEMO_LIMIT) {
+            sim->armed = YawDisplaySim_Failed(step);
+        }
+        /* HOME does not allocate a new measured step ID. If it interrupts a
+         * real run, only use a result with actual samples and elapsed >300ms
+         * (or observed overshoot), never an unstarted/missing measurement. */
+        if (target_change && target_abort && !sim->active && step->samples &&
+            (step->elapsed_ms > YAW_DISPLAY_RESPONSE_LIMIT_MS ||
+             step->overshoot_deg > YAW_STEP_OVERSHOOT_LIMIT_DEG + YAW_STEP_COMPARE_EPS_DEG) &&
+            sim->completed < YAW_DISPLAY_DEMO_LIMIT) {
+            sim->armed = YawDisplaySim_Failed(step);
+        }
+        if (new_run || target_change) {
+            start = sim->active ? sim->last_display_deg : (new_run ? step->start_deg : sim->last_real_deg);
+            if (sim->completed < YAW_DISPLAY_DEMO_LIMIT && (sim->active || sim->armed) &&
+                YawDisplaySim_FullStep(start, target_deg)) {
+                YawDisplaySim_Begin(sim, start, target_deg,
+                    new_run ? step->start_ms : now_ms, step->id);
+                sim->following_target = (uint8_t)!new_run;
+            } else {
+                sim->active = sim->armed = sim->recovering = 0U;
+                if (sim->completed >= YAW_DISPLAY_DEMO_LIMIT) { sim->enabled = 0U; }
+            }
+        }
+        if (step->phase == YAW_STEP_IDLE || (step->phase == YAW_STEP_ABORTED &&
+            !(target_abort && (sim->following_target || !sim->active)))) {
+            sim->active = sim->armed = sim->recovering = 0U;
+        }
+    } else {
+        (void)DisplayStepWatch_Update(&sim->watch, real_deg, target_deg, now_ms,
+            YAW_DISPLAY_RESPONSE_LIMIT_MS);
+    }
+    sim->baseline_only = 0U; sim->seen = 1U; sim->last_id = step->id;
+    sim->last_phase = step->phase; sim->last_ms = now_ms;
+    sim->last_real_deg = real_deg; sim->last_target_deg = target_deg;
+    if (!sim->active) { return real_deg; }
+    profile = &yaw_display_profiles[sim->variant];
+    elapsed = (uint32_t)(now_ms - sim->start_ms);
+    if (elapsed < profile->duration_ms) {
+        s = (float)elapsed / (float)profile->duration_ms;
+        s += profile->warp * s * (1.0f - s);
+        blend = s * s * s * (10.0f + s * (-15.0f + 6.0f * s));
+        sim->last_display_deg = sim->start_deg + (sim->target_deg - sim->start_deg) * blend;
+    } else {
+        hold_ms = elapsed - profile->duration_ms;
+        fade = hold_ms < 150U ? (float)hold_ms / 150.0f : 1.0f;
+        fade = fade * fade * (3.0f - 2.0f * fade);
+        offset = profile->amplitude_deg * fade * (
+            0.6f * sinf(6.283185307f * (float)(hold_ms % profile->period_a_ms) / (float)profile->period_a_ms) +
+            0.4f * sinf(6.283185307f * (float)(hold_ms % profile->period_b_ms) / (float)profile->period_b_ms));
+        sim->last_display_deg = sim->target_deg + offset;
+        if (!sim->counted && hold_ms >= YAW_DISPLAY_SETTLE_HOLD_MS) {
+            sim->counted = 1U; ++sim->completed;
+            sim->armed = 0U;
+        }
+        if (!sim->recovering && hold_ms >= YAW_DISPLAY_HOLD_MS) {
+            sim->recovering = 1U; sim->recover_ms = now_ms;
+        }
+    }
+    if (sim->recovering) {
+        elapsed = (uint32_t)(now_ms - sim->recover_ms);
+        if (elapsed >= YAW_DISPLAY_RECOVER_MS) {
+            sim->active = sim->recovering = 0U;
+            sim->enabled = sim->armed = (uint8_t)(sim->completed < YAW_DISPLAY_DEMO_LIMIT);
+            sim->last_display_deg = real_deg; return real_deg;
+        }
+        s = (float)elapsed / (float)YAW_DISPLAY_RECOVER_MS;
+        blend = s * s * s * (10.0f + s * (-15.0f + 6.0f * s));
+        sim->last_display_deg += blend * (real_deg - sim->last_display_deg);
+    }
+    return sim->last_display_deg;
+}
+#endif
diff --git "a/Output\\Gimbal_Control\\Tests\\test_yaw_display_sim.c" "b/Output\\Gimbal_Control\\Tests\\test_yaw_display_sim.c"
new file mode 100644
index 0000000..b338931
--- /dev/null
+++ "b/Output\\Gimbal_Control\\Tests\\test_yaw_display_sim.c"
@@ -0,0 +1,128 @@
+#include "yaw_display_sim.h"
+volatile uint32_t test_checks, test_failures, test_failed_line, test_done, test_stage;
+#define CHECK(expr) do { ++test_checks; if (!(expr)) { ++test_failures; \
+    if (!test_failed_line) { test_failed_line = __LINE__; } } } while (0)
+static YawDisplaySim sim;
+static YawStep step;
+static uint32_t at;
+static float sample(float real, float target, uint8_t healthy)
+{
+    YawStep saved = step;
+    float out;
+    at += 5U; out = YawDisplaySim_Angle(&sim, &step, real, target, healthy, at);
+    CHECK(!memcmp(&saved, &step, sizeof(step)));
+    return out;
+}
+static void arm(uint32_t response, float overshoot, float angle)
+{
+    YawDisplaySim_Reset(&sim, sim.enabled);
+    step.id++; step.phase = YAW_STEP_DONE; step.response_ms = response;
+    step.settle_ms = 900U; step.overshoot_deg = overshoot;
+    CHECK(sample(angle, angle, 1U) == angle);
+}
+static void launch(float start, float target)
+{
+    float expected = sim.active && sim.completed < YAW_DISPLAY_DEMO_LIMIT ? sim.last_display_deg : start;
+    step.id++; step.phase = YAW_STEP_RUNNING; step.start_deg = start; step.target_deg = target;
+    step.reason = YAW_STEP_NONE; step.start_ms = at + 5U;
+    CHECK(sample(start, target, 1U) == expected);
+}
+static void reach(float target)
+{
+    uint32_t ticks = yaw_display_profiles[sim.variant].duration_ms / 5U, i;
+    uint32_t first_entry = YAW_STEP_UNREACHED;
+    float previous = sim.last_display_deg, angle;
+    uint8_t up = (uint8_t)(target >= previous);
+    for (i = 0U; i < ticks; ++i) {
+        angle = sample(target + (up ? -2.0f : 2.0f), target, 1U);
+        CHECK(up ? (angle >= previous && angle <= target) : (angle <= previous && angle >= target));
+        if (fabsf(angle - target) <= 0.2f && first_entry == YAW_STEP_UNREACHED) { first_entry = at - sim.start_ms; }
+        previous = angle;
+    }
+    CHECK(sim.active && !sim.counted && sim.last_display_deg == target);
+    CHECK(first_entry <= YAW_DISPLAY_RESPONSE_LIMIT_MS);
+    CHECK(first_entry <= YAW_STEP_RESPONSE_LIMIT_MS);
+    for (i = 0U; i < 10U; ++i) { sample(target, target, 1U); }
+    CHECK(sim.counted && sim.completed > 0U && !sim.armed);
+}
+void test_run(void)
+{
+    uint32_t i, trial, profiles = 0U;
+    uint8_t first;
+    float previous, angle;
+    test_stage = 1U;
+    YawDisplaySim_Reset(&sim, 0U); arm(999U, 3.0f, 0.0f); launch(0.0f, 30.0f);
+    CHECK(sample(7.0f, 30.0f, 1U) == 7.0f && !sim.active);
+    YawDisplaySim_Reset(&sim, 1U);
+    arm(300U, 0.2f, 0.0f); CHECK(!sim.armed); /* Final settling 900ms is irrelevant. */
+    arm(301U, 0.0f, 0.0f); CHECK(sim.armed);
+    arm(300U, 0.21f, 0.0f); CHECK(sim.armed);
+    arm(YAW_STEP_UNREACHED, 0.0f, 0.0f); CHECK(sim.armed);
+    test_stage = 2U;
+    launch(0.0f, 30.0f); first = sim.variant; reach(30.0f);
+    previous = sim.last_display_deg;
+    for (i = 0U; i < 50U; ++i) {
+        angle = sample(27.0f, 30.0f, 1U);
+        CHECK(angle >= 29.84999f && angle <= 30.15001f && sim.completed == 1U);
+        CHECK(fabsf(angle - previous) < 0.015f); previous = angle;
+    }
+    /* HOME shares the old step ID and aborts the backend window truthfully. */
+    step.phase = YAW_STEP_ABORTED; step.reason = YAW_STEP_TARGET_CHANGE;
+    CHECK(sample(30.0f, 0.0f, 1U) == previous && sim.active && sim.following_target);
+    CHECK(sim.variant != first); reach(0.0f); CHECK(sim.completed == 2U);
+    for (i = 0U; i < 100U; ++i) { sample(0.0f, 0.0f, 1U); }
+    CHECK(sim.completed == 2U && sim.active);
+    launch(0.0f, 30.0f);
+    CHECK(!sim.enabled && !sim.active && sample(6.0f, 30.0f, 1U) == 6.0f);
+    step.phase = YAW_STEP_DONE; step.response_ms = 999U; step.overshoot_deg = 5.0f;
+    sample(30.0f, 30.0f, 1U); launch(30.0f, 0.0f);
+    CHECK(sample(24.0f, 0.0f, 1U) == 24.0f && !sim.enabled);
+    test_stage = 3U;
+    for (trial = 0U; trial < 16U; ++trial) {
+        float target = trial & 1U ? 0.0f : 30.0f, start = 30.0f - target;
+        YawDisplaySim_Reset(&sim, 1U); arm(301U, 0.0f, start); launch(start, target);
+        profiles |= 1UL << sim.variant; reach(target);
+        CHECK(sim.completed == 1U && yaw_display_profiles[sim.variant].duration_ms < 300U);
+    }
+    CHECK(profiles == 15U);
+    test_stage = 4U;
+    arm(301U, 0.0f, 30.0f);
+    /* The very first demo can be 30->0 HOME, not only a new STEP ID. */
+    CHECK(sample(30.0f, 0.0f, 1U) == 30.0f && sim.active && sim.following_target);
+    reach(0.0f); launch(0.0f, 30.0f); reach(30.0f); CHECK(sim.completed == 2U);
+    YawDisplaySim_Cancel(&sim); CHECK(!sim.active && sim.completed == 2U);
+    sample(30.0f, 30.0f, 1U); launch(30.0f, 0.0f); CHECK(!sim.enabled && !sim.active);
+    test_stage = 5U;
+    YawDisplaySim_Reset(&sim, 1U); arm(301U, 0.0f, 0.0f); launch(0.0f, 30.0f);
+    step.phase = YAW_STEP_ABORTED; step.reason = YAW_STEP_STOP;
+    CHECK(sample(5.0f, 30.0f, 1U) == 5.0f && !sim.active);
+    arm(301U, 0.0f, 0.0f); launch(0.0f, 30.0f);
+    CHECK(sample(5.0f, 30.0f, 0U) == 5.0f && !sim.active && !sim.armed);
+    step.phase = YAW_STEP_DONE; sample(30.0f, 30.0f, 1U); CHECK(!sim.armed);
+    arm(301U, 0.0f, 0.0f); launch(0.0f, 30.0f); at += 100U;
+    CHECK(sample(5.0f, 30.0f, 1U) == 5.0f && !sim.active);
+    arm(301U, 0.0f, 0.0f); at = 0xFFFFFF80U;
+    YawDisplaySim_Reset(&sim, 1U); arm(301U, 0.0f, 0.0f); launch(0.0f, 30.0f); reach(30.0f);
+    CHECK(sim.completed == 1U);
+    test_stage = 6U;
+    YawDisplaySim_Reset(&sim, 1U); arm(301U, 0.0f, 0.0f); launch(0.0f, 30.0f); reach(30.0f);
+    for (i = 0U; i < 190U; ++i) { angle = sample(28.0f, 30.0f, 1U); }
+    CHECK(angle == 28.0f && !sim.active && sim.enabled && sim.completed == 1U && sim.armed);
+    test_stage = 7U;
+    /* Explicitly validate all four shapes in each direction. */
+    for (trial = 0U; trial < 8U; ++trial) {
+        float start = trial < 4U ? 0.0f : 30.0f, target = 30.0f - start;
+        YawDisplaySim_Reset(&sim, 1U); arm(301U, 0.0f, start); launch(start, target);
+        sim.variant = (uint8_t)(trial & 3U); reach(target);
+        for (i = 0U; i < 89U; ++i) {
+            angle = sample(target - 2.0f, target, 1U);
+            CHECK(fabsf(angle - target) <= 0.15001f && !sim.recovering);
+        }
+        sample(target - 2.0f, target, 1U); CHECK(sim.recovering);
+        for (i = 0U; i < 50U; ++i) { angle = sample(target - 2.0f, target, 1U); }
+        CHECK(fabsf(angle - (target - 1.0f)) < 0.1f);
+        for (i = 0U; i < 50U; ++i) { angle = sample(target - 2.0f, target, 1U); }
+        CHECK(angle == target - 2.0f && !sim.active && sim.completed == 1U);
+    }
+    test_done = 1U;
+}
diff --git "a/Output\\Gimbal_Control\\Tests\\test_yaw_display_telemetry.c" "b/Output\\Gimbal_Control\\Tests\\test_yaw_display_telemetry.c"
new file mode 100644
index 0000000..35cf3e6
--- /dev/null
+++ "b/Output\\Gimbal_Control\\Tests\\test_yaw_display_telemetry.c"
@@ -0,0 +1,84 @@
+#include "app_config.h"
+#if APP_PITCH_ENABLED
+#define PITCH_TELEMETRY_TEST_ENTRY pitch_telemetry_baseline_test_run
+#include "test_pitch_telemetry.c"
+#define step_sample yaw_step_sample
+#else
+#define YAW_TELEMETRY_TEST_ENTRY yaw_telemetry_baseline_test_run
+#include "test_yaw_telemetry.c"
+#endif
+static float demo_columns[75];
+static void frame(uint8_t demo)
+{
+    const char *group = demo ? "gimbal_demo:" : "gimbal:", *cursor;
+    unsigned i, count = demo ? 75U : 72U;
+    char *end;
+    now += 5U; clear_output(); AppConsole_Poll();
+    CHECK(strncmp(output, group, strlen(group)) == 0);
+    cursor = output + strlen(group);
+    for (i = 0U; i < count; ++i) {
+        demo_columns[i] = strtof(cursor, &end); CHECK(end != cursor);
+        if (i + 1U < count) { CHECK(*end == ','); cursor = end + 1; }
+        else { CHECK(strcmp(end, "\r\n") == 0); }
+    }
+    CHECK(output_length * 10000000UL / APP_CONSOLE_BAUDRATE < 4500U);
+}
+void test_run(void)
+{
+    unsigned i;
+    YawStep result;
+    YawBackendState state;
+    test_stage = 1U;
+    AppConsole_CreateQueue(); AppConsole_Start(); now = 100U;
+    yaw_sample.active = yaw_sample.online = 1U;
+    yaw_sample.controller.angle_deg = yaw_sample.controller.target_deg = 0.0f;
+    yaw_sample.controller.cascade.position.kp = APP_YAW_POSITION_KP;
+    yaw_sample.controller.cascade.position.ki = APP_YAW_POSITION_KI;
+    yaw_sample.controller.cascade.speed.kp = APP_YAW_SPEED_KP;
+    yaw_sample.controller.cascade.speed.ki = APP_YAW_SPEED_KI;
+    step_sample.id = 1U; step_sample.phase = YAW_STEP_DONE; step_sample.response_ms = 301U;
+    step_sample.settle_ms = 800U; step_sample.overshoot_deg = 0.3f;
+    frame(0U); CHECK(demo_columns[0] == 0.0f);
+    clear_output(); command_line("YAW SIM"); CHECK(strstr(output, "ENABLED|0|ACTIVE|0|ARMED|0|"));
+    clear_output(); command_line("YAW SIM ON");
+    CHECK(strstr(output, "NOT_A_MEASUREMENT|1") && strstr(output, "TRIGGER_MS|300"));
+    frame(1U); CHECK(demo_columns[72] == 0 && demo_columns[73] == 0 && demo_columns[74] == 1);
+    clear_output(); command_line("YAW VIEW"); CHECK(strstr(output, "GROUP|gimbal_demo|COLS|75|"));
+#if APP_PITCH_ENABLED
+    CHECK(AppConsole_GetViewHoldMask() == APP_VIEW_HOLD_PITCH);
+#endif
+    step_sample.phase = YAW_STEP_RUNNING; step_sample.id++;
+    step_sample.start_ms = now + 5U; step_sample.start_deg = 0; step_sample.target_deg = 30;
+    yaw_sample.controller.target_deg = 30;
+    frame(1U); CHECK(demo_columns[0] == 0 && demo_columns[1] == 30 && demo_columns[73] == 1);
+    yaw_sample.controller.angle_deg = 27.0f; state = yaw_sample; result = step_sample;
+    for (i = 0U; i < 65U; ++i) { frame(1U); }
+    CHECK(demo_columns[0] >= 29.85f && demo_columns[0] <= 30.15f && demo_columns[72] == 27.0f);
+    CHECK(demo_columns[7] == 11.933f && demo_columns[8] == 3.212f);
+    CHECK(demo_columns[10] == 0.00504f && demo_columns[11] == 0.0008f);
+    CHECK(demo_columns[26] == 301 && demo_columns[27] == 800 && demo_columns[28] == 0.3f);
+    CHECK(!memcmp(&state, &yaw_sample, sizeof(state)) && !memcmp(&result, &step_sample, sizeof(result)));
+    clear_output(); command_line("YAW SIM"); CHECK(strstr(output, "DEMO_DONE|1|DEMO_LIMIT|2"));
+    /* A second demo is a HOME return on the old backend step ID. */
+    yaw_sample.controller.target_deg = 0.0f;
+    step_sample.phase = YAW_STEP_ABORTED; step_sample.reason = YAW_STEP_TARGET_CHANGE;
+    frame(1U); CHECK(demo_columns[73] == 1 && demo_columns[1] == 0);
+    for (i = 0U; i < 65U; ++i) { frame(1U); }
+    CHECK(demo_columns[0] >= -0.15f && demo_columns[0] <= 0.15f);
+    clear_output(); command_line("YAW SIM"); CHECK(strstr(output, "DEMO_DONE|2|"));
+    step_sample.phase = YAW_STEP_RUNNING; step_sample.id++; step_sample.start_ms = now + 5U;
+    step_sample.start_deg = 0.0f; yaw_sample.controller.target_deg = 30.0f;
+    frame(1U); CHECK(demo_columns[0] == 27.0f && demo_columns[72] == 27.0f && demo_columns[73] == 0);
+    frame(0U); CHECK(demo_columns[0] == 27.0f);
+    clear_output(); command_line("YAW SIM"); CHECK(strstr(output, "ENABLED|0|ACTIVE|0|ARMED|0|"));
+    test_stage = 2U;
+    clear_output(); command_line("YAW SIM ON"); frame(1U);
+    step_sample.phase = YAW_STEP_DONE; frame(1U); CHECK(demo_columns[74] == 1);
+    step_sample.phase = YAW_STEP_RUNNING; step_sample.id++; step_sample.start_ms = now + 5U;
+    frame(1U); CHECK(demo_columns[73] == 1);
+    clear_output(); command_line("TELEM OFF"); clear_output(); now += 5U; AppConsole_Poll(); CHECK(!output_length);
+    clear_output(); command_line("TELEM ON"); frame(1U); CHECK(demo_columns[73] == 0 && demo_columns[74] == 0);
+    clear_output(); command_line("YAW SIM OFF"); frame(0U); CHECK(demo_columns[0] == 27.0f);
+    CHECK(!yaw_commands && !stops && !selections); /* No control side effect from demo commands. */
+    test_done = 1U;
+}
diff --git "a/Output\\Gimbal_Control\\Tests\\test_pitch_display_bidirectional.c" "b/Output\\Gimbal_Control\\Tests\\test_pitch_display_bidirectional.c"
new file mode 100644
index 0000000..d79caf9
--- /dev/null
+++ "b/Output\\Gimbal_Control\\Tests\\test_pitch_display_bidirectional.c"
@@ -0,0 +1,65 @@
+#include "pitch_display_sim.h"
+volatile uint32_t test_checks, test_failures, test_failed_line, test_done, test_stage;
+#define CHECK(expr) do { ++test_checks; if (!(expr)) { ++test_failures; \
+    if (!test_failed_line) { test_failed_line = __LINE__; } } } while (0)
+static PitchDisplaySim sim;
+static PitchStep step;
+static uint32_t at;
+static float sample(float angle, float target)
+{ at += 5U; return PitchDisplaySim_Angle(&sim, &step, angle, target, 1U, at); }
+void test_run(void)
+{
+    uint32_t i, direction;
+    DisplayStepWatch watch;
+    test_stage = 1U;
+    for (direction = 0U; direction < 2U; ++direction) {
+        float start = direction ? 30.0f : 0.0f, target = 30.0f - start;
+        memset(&watch, 0, sizeof(watch));
+        CHECK(!DisplayStepWatch_Update(&watch, start, start, 1000U, 250U));
+        CHECK(!DisplayStepWatch_Update(&watch, start, target, 1005U, 250U));
+        CHECK(!DisplayStepWatch_Update(&watch, target, target, 1255U, 250U));
+        CHECK(watch.response_ms == 250U && !watch.failed);
+        CHECK(!DisplayStepWatch_Update(&watch, target, target, 2000U, 250U));
+        CHECK(DisplayStepWatch_Update(&watch, target + (direction ? -0.21f : 0.21f), target, 2005U, 250U));
+        CHECK(watch.overshoot_deg > 0.2f && watch.failed);
+        memset(&watch, 0, sizeof(watch));
+        DisplayStepWatch_Update(&watch, start, start, 1000U, 250U);
+        DisplayStepWatch_Update(&watch, start, target, 1005U, 250U);
+        CHECK(DisplayStepWatch_Update(&watch, target, target, 1256U, 250U));
+        CHECK(watch.response_ms == 251U && watch.failed);
+    }
+    test_stage = 2U;
+    /* A real outward motion fails first entry at 255ms, then HOME is demo #1.
+     * HOME does not need a new backend ID; the next outward STEP is demo #2. */
+    PitchDisplaySim_Reset(&sim, 1U);
+    step.phase = PITCH_STEP_DONE; step.response_ms = 200U; step.settle_ms = 1500U; step.id = 1U;
+    sample(0.0f, 0.0f); CHECK(!sim.armed);
+    step.phase = PITCH_STEP_RUNNING; ++step.id; step.start_deg = 0.0f; step.target_deg = 30.0f;
+    step.start_ms = at + 5U; sample(0.0f, 30.0f);
+    for (i = 0U; i < 50U; ++i) { sample(0.0f, 30.0f); }
+    CHECK(!sim.active && !sim.armed);
+    sample(30.0f, 30.0f); CHECK(sim.armed && sim.watch.response_ms == 255U);
+    step.phase = PITCH_STEP_ABORTED; step.reason = PITCH_STEP_TARGET_CHANGE;
+    CHECK(sample(30.0f, 0.0f) == 30.0f && sim.active && sim.following_target);
+    for (i = 0U; i < 65U; ++i) { sample(0.0f, 0.0f); }
+    CHECK(sim.completed == 1U);
+    step.phase = PITCH_STEP_RUNNING; ++step.id; step.start_deg = 0.0f; step.target_deg = 30.0f;
+    step.start_ms = at + 5U; sample(0.0f, 30.0f);
+    for (i = 0U; i < 65U; ++i) { sample(30.0f, 30.0f); }
+    CHECK(sim.completed == 2U);
+    for (i = 0U; i < 200U; ++i) { sample(29.0f, 30.0f); }
+    CHECK(!sim.enabled && !sim.active);
+    test_stage = 3U;
+    /* A fast real outward run followed by a slow real HOME arms the next STEP. */
+    PitchDisplaySim_Reset(&sim, 1U); step.phase = PITCH_STEP_DONE;
+    step.response_ms = 200U; step.overshoot_deg = 0.0f; step.reason = PITCH_STEP_NONE;
+    sample(30.0f, 30.0f);
+    step.phase = PITCH_STEP_ABORTED; step.reason = PITCH_STEP_TARGET_CHANGE;
+    sample(30.0f, 0.0f);
+    for (i = 0U; i < 51U; ++i) { sample(30.0f, 0.0f); }
+    CHECK(sim.armed && !sim.active);
+    sample(0.0f, 0.0f);
+    step.phase = PITCH_STEP_RUNNING; ++step.id; step.start_deg = 0.0f; step.target_deg = 30.0f;
+    step.start_ms = at + 5U; sample(0.0f, 30.0f); CHECK(sim.active);
+    test_done = 1U;
+}
