+    while ((int32_t)(end - now) > 0) { Tick(now + 10U, 1500U, 1U, 1U, 1U); }
+    YawBackend_GetStep(&measured); Read();
+    CHECK(measured.phase == YAW_STEP_DONE && !pitch.peer_step_locked);
